{
  "type": "VBox",
  "id": "editor_root",
  "size": { "w": 1280, "h": 720 },
  "spacing": 0,
  "children": [
    {
      "type": "HBox",
      "id": "menubar_row",
      "size": { "h": 26 },
      "spacing": 4,
      "padding": { "left": 6, "top": 2, "right": 4, "bottom": 2 },
      "children": [
        {
          "type": "Image",
          "id": "app_logo",
          "size": { "w": 20, "h": 20 },
          "color": [0.25, 0.55, 0.95, 1.0],
          "slot": { "width": 22 }
        },
        {
          "type": "MenuBar",
          "id": "menubar",
          "size": { "w": 240, "h": 26 },
          "slot": { "width": 240 }
        },
        {
          "type": "TextLabel",
          "id": "menubar_spacer",
          "text": "",
          "size": { "w": 0, "h": 22 }
        },
        {
          "type": "Button",
          "id": "btn_minimize",
          "text": "-",
          "size": { "w": 28, "h": 22 },
          "slot": { "width": 28 }
        },
        {
          "type": "Button",
          "id": "btn_maximize",
          "text": "口",
          "size": { "w": 28, "h": 22 },
          "slot": { "width": 28 }
        },
        {
          "type": "Button",
          "id": "btn_close",
          "text": "X",
          "size": { "w": 28, "h": 22 },
          "slot": { "width": 28 }
        }
      ]
    },
    {
      "type": "HBox",
      "id": "icon_toolbar",
      "size": { "h": 28 },
      "spacing": 4,
      "padding": { "left": 6, "top": 2, "right": 6, "bottom": 2 },
      "children": [
        {
          "type": "Button",
          "id": "btn_icon_1",
          "text": "T1",
          "size": { "w": 28, "h": 22 },
          "slot": { "width": 28 }
        },
        {
          "type": "Button",
          "id": "btn_icon_2",
          "text": "T2",
          "size": { "w": 28, "h": 22 },
          "slot": { "width": 28 }
        },
        {
          "type": "TextLabel",
          "id": "lbl_mode",
          "text": "EDIT",
          "size": { "w": 72, "h": 22 },
          "slot": { "width": 72 }
        }
      ]
    },
    {
      "type": "HBox",
      "id": "main_row",
      "spacing": 0,
      "children": [
        {
          "type": "Window",
          "id": "panel_hierarchy",
          "text": "Render",
          "size": { "w": 220, "h": 0 },
          "minSize": { "w": 180, "h": 120 },
          "movable": false,
          "slot": {
            "width": 240,
            "minWidth": 180,
            "maxWidthPercent": 45
          },
          "children": [
            { "type": "TextLabel", "id": "lbl_render_hdr", "text": "Post / Look", "size": { "w": 200, "h": 22 } },
            { "type": "TextLabel", "id": "lbl_gamma", "text": "Gamma  2.20", "size": { "w": 200, "h": 18 } },
            { "type": "Slider", "id": "sld_gamma", "min": 1.0, "max": 3.0, "value": 2.2, "size": { "w": 200, "h": 22 } },
            { "type": "TextLabel", "id": "lbl_exposure", "text": "Exposure  1.00", "size": { "w": 200, "h": 18 } },
            { "type": "Slider", "id": "sld_exposure", "min": 0.2, "max": 3.0, "value": 1.0, "size": { "w": 200, "h": 22 } },
            { "type": "TextLabel", "id": "lbl_bloom", "text": "Bloom  0.30", "size": { "w": 200, "h": 18 } },
            { "type": "Slider", "id": "sld_bloom", "min": 0.0, "max": 1.5, "value": 0.3, "size": { "w": 200, "h": 22 } },
            { "type": "CheckBox", "id": "chk_depth_haze", "text": "Depth Haze", "checked": true, "size": { "w": 200, "h": 22 } },
            { "type": "TextLabel", "id": "lbl_haze_strength", "text": "Haze Strength  1.00", "size": { "w": 200, "h": 18 } },
            { "type": "Slider", "id": "sld_haze_strength", "min": 0.0, "max": 1.5, "value": 1.0, "size": { "w": 200, "h": 22 } },
            { "type": "TextLabel", "id": "lbl_haze_density", "text": "Haze Density  0.040", "size": { "w": 200, "h": 18 } },
            { "type": "Slider", "id": "sld_haze_density", "min": 0.0, "max": 0.2, "value": 0.04, "size": { "w": 200, "h": 22 } },
            { "type": "CheckBox", "id": "chk_ssao", "text": "SSAO", "checked": true, "size": { "w": 200, "h": 22 } },
            { "type": "TextLabel", "id": "lbl_ssao_strength", "text": "SSAO Strength  0.45", "size": { "w": 200, "h": 18 } },
            { "type": "Slider", "id": "sld_ssao_strength", "min": 0.0, "max": 1.5, "value": 0.45, "size": { "w": 200, "h": 22 } },
            { "type": "TextLabel", "id": "lbl_ssao_radius", "text": "SSAO Radius  0.40", "size": { "w": 200, "h": 18 } },
            { "type": "Slider", "id": "sld_ssao_radius", "min": 0.05, "max": 2.0, "value": 0.4, "size": { "w": 200, "h": 22 } },
            { "type": "TextLabel", "id": "lbl_ssao_bias", "text": "SSAO Bias  0.040", "size": { "w": 200, "h": 18 } },
            { "type": "Slider", "id": "sld_ssao_bias", "min": 0.0, "max": 0.1, "value": 0.04, "size": { "w": 200, "h": 22 } },
            { "type": "TextLabel", "id": "lbl_ambient", "text": "IBL Ambient  0.85", "size": { "w": 200, "h": 18 } },
            { "type": "Slider", "id": "sld_ambient", "min": 0.0, "max": 2.0, "value": 0.85, "size": { "w": 200, "h": 22 } },
            { "type": "TextLabel", "id": "lbl_tonemap", "text": "Tonemap", "size": { "w": 200, "h": 18 } },
            {
              "type": "ComboBox",
              "id": "cmb_tonemap",
              "size": { "w": 200, "h": 24 },
              "items": ["None", "Reinhard", "ACES"],
              "selectedIndex": 2,
              "maxPopupItems": 3
            },
            { "type": "TextLabel", "id": "lbl_render_quality", "text": "Quality", "size": { "w": 200, "h": 22 } },
            { "type": "CheckBox", "id": "chk_shadow_pcf", "text": "Shadow PCF", "checked": true, "size": { "w": 200, "h": 22 } },
            { "type": "TextLabel", "id": "lbl_shadow_bias", "text": "Shadow Bias  0.003", "size": { "w": 200, "h": 18 } },
            { "type": "Slider", "id": "sld_shadow_bias", "min": 0.0, "max": 0.02, "value": 0.003, "size": { "w": 200, "h": 22 } },
            { "type": "TextLabel", "id": "lbl_render_hint", "text": "Live after Play starts", "size": { "w": 200, "h": 18 } }
          ]
        },
        { "type": "SplitterHandle", "id": "split_hierarchy_viewport" },
        {
          "type": "Image",
          "id": "panel_viewport",
          "size": { "w": 0, "h": 0 },
          "color": [0.08, 0.09, 0.11, 1.0],
          "slot": {
            "minWidthPercent": 20
          }
        },
        { "type": "SplitterHandle", "id": "split_viewport_inspector" },
        {
          "type": "Window",
          "id": "panel_inspector",
          "text": "Inspector",
          "size": { "w": 280, "h": 0 },
          "minSize": { "w": 180, "h": 120 },
          "movable": false,
          "slot": {
            "width": 280,
            "minWidth": 180,
            "maxWidthPercent": 40
          },
          "children": [
            { "type": "TextLabel", "id": "inspector_hint",      "text": "No selection", "size": { "w": 240, "h": 24 } },
            { "type": "TextLabel", "id": "inspector_mesh",      "text": "mesh: -",       "size": { "w": 240, "h": 20 } },
            { "type": "TextLabel", "id": "inspector_skel",      "text": "skel: -",       "size": { "w": 240, "h": 20 } },
            { "type": "TextLabel", "id": "inspector_anim",      "text": "anim: -",       "size": { "w": 240, "h": 20 } },
            { "type": "Button",    "id": "btn_inspector_skel",  "text": "Pick Skel",     "size": { "w": 120, "h": 24 }, "onClick": "pick_skel" },
            { "type": "Button",    "id": "btn_inspector_anim",  "text": "Pick Anim",     "size": { "w": 120, "h": 24 }, "onClick": "pick_anim" },
            { "type": "Button",    "id": "btn_inspector_apply", "text": "Apply",         "size": { "w": 80,  "h": 24 }, "onClick": "apply_overrides" },
            { "type": "Button",    "id": "btn_inspector_reset", "text": "Reset",         "size": { "w": 80,  "h": 24 }, "onClick": "reset_overrides" }
          ]
        }
      ]
    }
  ]
}
