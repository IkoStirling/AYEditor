      "size": { "h": 22 },
      "spacing": 10,
      "padding": { "left": 8, "top": 2, "right": 8, "bottom": 2 },
      "children": [
        { "type": "TextLabel", "id": "lbl_status_scene", "text": "Scene: Untitled", "size": { "w": 180, "h": 18 }, "slot": { "width": 180 } },
        { "type": "TextLabel", "id": "lbl_unsaved", "text": "", "size": { "w": 18, "h": 18 }, "slot": { "width": 18 } },
        { "type": "TextLabel", "id": "status_spacer", "text": "", "size": { "w": 0, "h": 18 } },
        { "type": "TextLabel", "id": "lbl_status_network", "text": "Network: Offline", "size": { "w": 116, "h": 18 }, "slot": { "width": 116 } },
        { "type": "TextLabel", "id": "lbl_status_renderer", "text": "Renderer: Ready", "size": { "w": 110, "h": 18 }, "slot": { "width": 110 } },
        { "type": "TextLabel", "id": "lbl_status_fps", "text": "FPS --", "size": { "w": 48, "h": 18 }, "slot": { "width": 48 } }
