{
  "type": "VBox",
  "id": "editor_root",
  "size": { "w": 1280, "h": 720 },
  "spacing": 0,
  "children": [
    {
      "type": "HBox",
      "id": "menubar_row",
      "size": { "h": 26 },
      "spacing": 4,
      "padding": { "left": 6, "top": 2, "right": 4, "bottom": 2 },
      "children": [
        {
          "type": "Image",
          "id": "app_logo",
          "size": { "w": 20, "h": 20 },
          "color": [0.25, 0.55, 0.95, 1.0],
          "slot": { "width": 22 }
        },
        {
          "type": "MenuBar",
          "id": "menubar",
          "size": { "w": 240, "h": 26 },
          "slot": { "width": 240 }
        },
        {
          "type": "TextLabel",
          "id": "menubar_spacer",
          "text": "",
          "size": { "w": 0, "h": 22 }
        },
        {
          "type": "Button",
          "id": "btn_minimize",
          "text": "-",
          "size": { "w": 28, "h": 22 },
          "slot": { "width": 28 }
        },
        {
          "type": "Button",
          "id": "btn_maximize",
          "text": "口",
          "size": { "w": 28, "h": 22 },
          "slot": { "width": 28 }
        },
        {
          "type": "Button",
          "id": "btn_close",
          "text": "X",
          "size": { "w": 28, "h": 22 },
          "slot": { "width": 28 }
        }
      ]
    },
    {
      "type": "HBox",
      "id": "icon_toolbar",
      "size": { "h": 28 },
      "spacing": 4,
      "padding": { "left": 6, "top": 2, "right": 6, "bottom": 2 },
      "children": [
        {
          "type": "Button",
          "id": "btn_icon_1",
          "text": "T1",
          "size": { "w": 28, "h": 22 },
          "slot": { "width": 28 }
        },
        {
          "type": "Button",
          "id": "btn_icon_2",
          "text": "T2",
          "size": { "w": 28, "h": 22 },
          "slot": { "width": 28 }
        },
        {
          "type": "TextLabel",
          "id": "lbl_mode",
          "text": "EDIT",
          "size": { "w": 72, "h": 22 },
          "slot": { "width": 72 }
        }
      ]
    },
    {
      "type": "HBox",
      "id": "main_row",
      "spacing": 0,
      "children": [
        {
          "type": "Window",
          "id": "panel_hierarchy",
          "text": "Hierarchy",
          "size": { "w": 220, "h": 0 },
          "minSize": { "w": 160, "h": 120 },
          "movable": true,
          "slot": {
            "width": 220,
            "minWidth": 160,
            "maxWidthPercent": 45
          },
          "children": [
            { "type": "TextLabel", "id": "hierarchy_hint", "text": "(empty)", "size": { "w": 180, "h": 24 } },
            { "type": "TextLabel", "id": "hierarchy_hint2", "text": "Scene root", "size": { "w": 180, "h": 24 } }
          ]
        },
        { "type": "SplitterHandle", "id": "split_hierarchy_viewport" },
        {
          "type": "Image",
          "id": "panel_viewport",
          "size": { "w": 0, "h": 0 },
          "color": [0.08, 0.09, 0.11, 1.0],
          "slot": {
            "minWidthPercent": 20
          }
        },
        { "type": "SplitterHandle", "id": "split_viewport_inspector" },
        {
          "type": "Window",
          "id": "panel_inspector",
          "text": "Inspector",
          "size": { "w": 280, "h": 0 },
          "minSize": { "w": 180, "h": 120 },
          "movable": true,
          "slot": {
            "width": 280,
            "minWidth": 180,
            "maxWidthPercent": 40
          },
          "children": [
            { "type": "TextLabel", "id": "inspector_hint",      "text": "No selection", "size": { "w": 240, "h": 24 } },
            { "type": "TextLabel", "id": "inspector_mesh",      "text": "mesh: -",       "size": { "w": 240, "h": 20 } },
            { "type": "TextLabel", "id": "inspector_skel",      "text": "skel: -",       "size": { "w": 240, "h": 20 } },
            { "type": "TextLabel", "id": "inspector_anim",      "text": "anim: -",       "size": { "w": 240, "h": 20 } },
            { "type": "Button",    "id": "btn_inspector_skel",  "text": "Pick Skel",     "size": { "w": 120, "h": 24 }, "onClick": "pick_skel" },
            { "type": "Button",    "id": "btn_inspector_anim",  "text": "Pick Anim",     "size": { "w": 120, "h": 24 }, "onClick": "pick_anim" },
            { "type": "Button",    "id": "btn_inspector_apply", "text": "Apply",         "size": { "w": 80,  "h": 24 }, "onClick": "apply_overrides" },
            { "type": "Button",    "id": "btn_inspector_reset", "text": "Reset",         "size": { "w": 80,  "h": 24 }, "onClick": "reset_overrides" }
          ]
        }
      ]
    }
  ]
}
