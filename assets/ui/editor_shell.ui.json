              { "type": "TextInput", "id": "transform_rx", "text": "-", "size": { "w": 240, "h": 24 } },
              { "type": "TextInput", "id": "transform_ry", "text": "-", "size": { "w": 240, "h": 24 } },
              { "type": "TextInput", "id": "transform_rz", "text": "-", "size": { "w": 240, "h": 24 } },
              { "type": "TextLabel", "id": "inspector_scale_label", "text": "Scale X / Y / Z", "size": { "w": 240, "h": 18 } },
              { "type": "TextInput", "id": "transform_sx", "text": "-", "size": { "w": 240, "h": 24 } },
              { "type": "TextInput", "id": "transform_sy", "text": "-", "size": { "w": 240, "h": 24 } },
