        { "type": "Button", "id": "btn_play", "text": ">", "size": { "w": 38, "h": 28 }, "slot": { "width": 38 } },
        { "type": "Button", "id": "btn_pause", "text": "||", "size": { "w": 38, "h": 28 }, "slot": { "width": 38 } },
        { "type": "Button", "id": "btn_step", "text": ">|", "size": { "w": 38, "h": 28 }, "slot": { "width": 38 } },
        { "type": "Button", "id": "btn_stop", "text": "[]", "size": { "w": 38, "h": 28 }, "slot": { "width": 38 } },
        { "type": "TextLabel", "id": "toolbar_spacer_right", "text": "", "size": { "w": 0, "h": 28 } },
        { "type": "TextLabel", "id": "lbl_active_tool", "text": "Select", "size": { "w": 74, "h": 28 }, "slot": { "width": 74 } },
        { "type": "TextLabel", "id": "lbl_mode", "text": "EDIT", "size": { "w": 58, "h": 28 }, "slot": { "width": 58 } }
