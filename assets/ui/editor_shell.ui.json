        { "type": "Button", "id": "btn_tool_rotate", "text": "[E]", "size": { "w": 38, "h": 28 }, "slot": { "width": 38 } },
        { "type": "Button", "id": "btn_tool_scale", "text": "[R]", "size": { "w": 38, "h": 28 }, "slot": { "width": 38 } },
        { "type": "TextLabel", "id": "toolbar_divider_left", "text": "|", "size": { "w": 12, "h": 28 }, "slot": { "width": 12 } },
        { "type": "Button", "id": "btn_tool_space", "text": "World", "size": { "w": 58, "h": 28 }, "slot": { "width": 58 } },
