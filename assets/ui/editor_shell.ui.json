                  { "type": "TextLabel", "id": "lbl_console_counts", "text": "0 errors   0 warnings", "size": { "w": 142, "h": 24 }, "slot": { "width": 142 } }
                ]
              },
              { "type": "TextLabel", "id": "console_output", "text": "Console ready. Runtime messages will appear here.", "size": { "w": 600, "h": 56 } }
            ]
          }
        },
        {
          "slot": "Bottom",
          "id": "card_assets",
          "title": "Assets",
          "closable": true,
          "floatable": false,
          "content": {
            "type": "VBox",
            "id": "panel_assets_body",
            "spacing": 4,
            "padding": { "left": 8, "top": 5, "right": 8, "bottom": 5 },
            "children": [
